# Optional. Copy to .env only if you want to change the defaults.
# By default Sonara uses local Ollama (qwen2.5:1.5b-instruct) with no API key.

# A larger local model for replies (pull it first: ollama pull qwen2.5:7b-instruct):
# SONARA_GENERATOR_MODEL=qwen2.5:7b-instruct

# Opt-in only: Claude API instead of local models (billed separately from Claude Pro).
# SONARA_SENSOR_PROVIDER=anthropic
# SONARA_GENERATOR_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Turn off the bridge to the sonara_memory.py evidence store:
# SONARA_MEMORY_BRIDGE=0
